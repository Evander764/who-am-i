{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "who-am-i-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "who-am-i-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "out", "-l", "5000"],
      "port": 5000,
      "autoPort": true
    }
  ]
}
